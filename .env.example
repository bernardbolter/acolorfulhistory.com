# Protomaps API key (map tiles)
NEXT_PUBLIC_PROTOMAPS=

# Payload CMS archive API (bernardbolter.com) — sole data source
# No API key needed for public read. This site filters to SITE_SERIES_SLUGS
# (see lib/siteSeries.ts) — not the full 217-work archive on this Payload instance.
PAYLOAD_API_URL=
PAYLOAD_API_KEY=

# Dev-only hero fallback. Unset in production (empty CMS heroEligible pool
# must render a plain list). Set to a slug, or `random`, to fetch that
# painting and use local docs/hero JSON when Payload heroFields are empty.
# HERO_DEV_FALLBACK_SLUG=

# Vendure shop API (optional — enables add-to-cart on triptych pages)
NEXT_PUBLIC_VENDURE_SHOP_API=

# Neighborhood Commissions inquiry mailto (optional — also settable on
# Payload global `neighborhood-page`.inquiryEmail)
# NEIGHBORHOOD_INQUIRY_EMAIL=
